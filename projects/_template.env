# Project configuration, generated by `./gnrdev new <project>`.
# Ports can be edited by hand.

# --- project and instance -------------------------------------------------------
GNR_PROJECT=__PROJECT__
GNR_INSTANCE=__INSTANCE__

# Projects this instance takes packages from (pkgcode="project:package" in the
# instance config). Space-separated; used to install their requirements.
GNR_DEP_PROJECTS=

# --- shared network -------------------------------------------------------------
# Docker network to join, so projects can talk on internal ports.
# Create it with `./gnrdev network create <name>`, or pass --network to `new`.
# Empty = isolated on its own network.
GNR_NETWORK=

# --- ports (host) ---------------------------------------------------------------
GNR_PORT_WEB=__PORT_WEB__
GNR_PORT_DEBUG=__PORT_DEBUG__
# Port for an external postgres client; 0 = do not publish
GNR_PORT_DB=0

# --- database -------------------------------------------------------------------
GNR_DB_NAME=__INSTANCE__
GNR_DB_USER=genro
GNR_DB_PASSWORD=genro
POSTGRES_TAG=16

# --- application ----------------------------------------------------------------
GNR_ROOTPWD=admin
GNR_MAINPACKAGE=
GNR_LOCALE=it_IT
GNR_LOGLEVEL=info

# --- framework from source (only with --framework-src) --------------------------
# Branch, tag or commit to use; empty = leave the checkout as is
GNR_FRAMEWORK_REF=
