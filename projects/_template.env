# Project configuration, generated by `./gnrdev new <project>`.
# Ports can be edited by hand.

# --- project and instance -------------------------------------------------------
GNR_PROJECT=__PROJECT__
GNR_INSTANCE=__INSTANCE__

# Projects this instance takes packages from (pkgcode="project:package" in the
# instance config). Space-separated; used to install their requirements.
GNR_DEP_PROJECTS=

# --- shared network -------------------------------------------------------------
# Docker network to join, so projects can talk on internal ports.
# Create it with `./gnrdev network create <name>`, or pass --network to `new`.
# Empty = isolated on its own network.
GNR_NETWORK=

# --- ports (host) ---------------------------------------------------------------
GNR_PORT_WEB=__PORT_WEB__
GNR_PORT_DEBUG=__PORT_DEBUG__
GNR_PORT_DB=__PORT_DB__

# --- database -------------------------------------------------------------------
GNR_DB_NAME=__INSTANCE__
GNR_DB_USER=genro
GNR_DB_PASSWORD=genro
POSTGRES_TAG=18

# --- application ----------------------------------------------------------------
GNR_ROOTPWD=admin
GNR_MAINPACKAGE=
GNR_LOCALE=it_IT
GNR_LOGLEVEL=info

# --- framework ------------------------------------------------------------------
# How this project gets the framework at every start:
#   (empty)  the official image, at GENROPY_TAG
#   local    the host checkout (HOST_GENROPY), bind-mounted and editable
#   git      a clone of GNR_FRAMEWORK_REF, kept in a per-project volume
# `gnrdev up` can override this for a single run without touching this file.
GNR_FRAMEWORK_MODE=

# Branch, tag or commit; required when GNR_FRAMEWORK_MODE=git.
# Fetched and checked out on every start, so the container tracks the repo.
GNR_FRAMEWORK_REF=

# Repository to clone in git mode (default: the official Genropy repository)
GNR_FRAMEWORK_REPO=
