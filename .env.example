# Global configuration. Copy to .env and adjust the paths.

# --- source trees on the host ---------------------------------------------------
HOST_GENROPY=/Users/edo/Documents/Genropy/genropy
HOST_PROJECTS=/Users/edo/Documents/Genropy/genropy_projects
HOST_GNREXTRA=/Users/edo/Documents/Genropy/gnrextra_projects

# --- identity for the bind mounts -----------------------------------------------
# Align the container user with the host one (id -u / id -g), so files the
# daemon writes into the sitepath stay manageable.
HOST_UID=501
HOST_GID=20

# --- framework version ----------------------------------------------------------
# Official image tag: latest, develop, or a version such as 26.05.05
GENROPY_TAG=latest

# --- port allocation ------------------------------------------------------------
# Two parallel ranges; `gnrdev new` gives a project the same offset in both, so
# the last digits pair its web and debug ports (sandbox 9000/9100, ...).
GNR_PORT_WEB_BASE=9000
GNR_PORT_DEBUG_BASE=9100
